{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        // The `vibrate` device action. system_grant, so no reason/usedScene is
        // required; DeviceActionsPlugin.ets uses it for a one-shot buzz.
        "name": "ohos.permission.VIBRATE"
      },
      {
        // Voice mode: AudioRecordPlugin.ets's `hasPermission` requests this
        // before opening an AudioCapturer, and HarmonyOS refuses the request
        // outright if it is not declared here. user_grant, so the system shows
        // the prompt and the reason is shown with it.
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:permission_microphone",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ]
    // Note: ohos.permission.KEEP_BACKGROUND_RUNNING was removed intentionally.
    // No continuous-task (backgroundTasks) code exists in this module, so the
    // permission granted nothing and was an over-declaration. Consequence:
    // model downloads started in this OHOS port are suspended by the system
    // when the app moves to the background; long transfers must keep the app
    // in the foreground. Wiring a continuous task (ohos.backgroundTaskManager)
    // is the future enhancement that would justify re-adding the permission.
  }
}

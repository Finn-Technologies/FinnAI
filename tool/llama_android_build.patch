diff --git a/tool/build_android_aar.sh b/tool/build_android_aar.sh
index 9a61d26..145a989 100755
--- a/tool/build_android_aar.sh
+++ b/tool/build_android_aar.sh
@@ -22,7 +22,7 @@ AAR_OUT="$OUT_ROOT/llama-cpp-dart.aar"
 NDK="${ANDROID_NDK_ROOT:-}"
 ABI="arm64-v8a"
 CLEAN=0
-ANDROID_PLATFORM=26 # Android 8.0 (Oreo). Common floor for modern apps.
+ANDROID_PLATFORM=28 # Android 9: Vulkan 1.1 loader symbols (vkGetPhysicalDeviceFeatures2) are absent from the API-26 NDK stub. App minSdk remains 26; Vulkan 1.1 is guaranteed on all API-26+ devices per the Android CDD.
 
 while [[ $# -gt 0 ]]; do
   case "$1" in
@@ -91,7 +91,14 @@ cmake -G Ninja -B "$BUILD_DIR" -S "$LLAMA_SRC" \
   -DGGML_OPENMP=OFF \
   -DGGML_LLAMAFILE=OFF \
   -DGGML_NATIVE=OFF \
-  -DCMAKE_CXX_FLAGS="-O3 -DNDEBUG"
+  -DGGML_BACKEND_DL=ON \
+  -DGGML_CPU_ALL_VARIANTS=ON \
+  -DGGML_VULKAN=ON \
+  -DVulkan_INCLUDE_DIR="$(brew --prefix vulkan-headers)/include" \
+  -DVulkan_GLSLC_EXECUTABLE="$(brew --prefix shaderc)/bin/glslc" \
+  -DVulkan_LIBRARY="$NDK/toolchains/llvm/prebuilt/$(ls "$NDK/toolchains/llvm/prebuilt/" | head -1)/sysroot/usr/lib/aarch64-linux-android/$ANDROID_PLATFORM/libvulkan.so" \
+  -DSPIRV-Headers_DIR="$(brew --prefix spirv-headers)/share/cmake/SPIRV-Headers" \
+  -DCMAKE_CXX_FLAGS="-O3 -DNDEBUG -isystem $(brew --prefix spirv-headers)/include"
 
 echo "==== building"
 cmake --build "$BUILD_DIR" --parallel
@@ -100,7 +107,7 @@ cmake --install "$BUILD_DIR"
 # Collect runtime .so files. cmake --install drops them under
 # $INSTALL_DIR/lib/. Filter to the runtime set we ship.
 RUNTIME_SOS=()
-for so in libllama.so libggml.so libggml-base.so libggml-cpu.so libmtmd.so; do
+for so in libllama.so libggml.so libggml-base.so libmtmd.so libggml-vulkan.so; do
   if [[ -f "$INSTALL_DIR/lib/$so" ]]; then
     RUNTIME_SOS+=("$INSTALL_DIR/lib/$so")
   else
@@ -113,6 +120,9 @@ for so in libllama.so libggml.so libggml-base.so libggml-cpu.so libmtmd.so; do
     fi
   fi
 done
+while IFS= read -r so; do
+  RUNTIME_SOS+=("$so")
+done < <(find "$INSTALL_DIR/lib" "$BUILD_DIR" -name 'libggml-cpu*.so' -type f 2>/dev/null | sort -u)
 if [[ ${#RUNTIME_SOS[@]} -eq 0 ]]; then
   echo "error: no .so files found to package" >&2
   exit 1
@@ -140,7 +150,11 @@ cat >"$STAGE_DIR/AndroidManifest.xml" <<EOF
 <?xml version="1.0" encoding="utf-8"?>
 <manifest xmlns:android="http://schemas.android.com/apk/res/android"
     package="dev.netdur.llama_cpp_dart">
-    <uses-sdk android:minSdkVersion="$ANDROID_PLATFORM" />
+    <!-- Native runtime links against the android-28 libvulkan stub (Vulkan
+         1.1 symbols); the hosting app still sets its own minSdk (26), and
+         Vulkan 1.1 is guaranteed on every API-26+ device by the Android
+         CDD, so the app floor is preserved here. -->
+    <uses-sdk android:minSdkVersion="26" />
 </manifest>
 EOF
 

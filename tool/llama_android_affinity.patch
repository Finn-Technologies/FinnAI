+// FinnAI: detect the fastest CPU cluster (big cores) from sysfs so inference
+// threads can be pinned off the efficiency cores. On big.LITTLE SoCs a
+// worker that lands on an A55 becomes the straggler every per-node barrier
+// waits for: the 4th decode thread on SM7325 collapses decode from ~190 ms
+// to ~8.5 s per token. Only cores matching the global max frequency are
+// selected, which on tri-cluster parts picks just the top cluster.
+// Returns false when detection is unavailable (non-Linux or no sysfs).
+static bool ggml_detect_fastest_cluster(bool * mask) {
+    memset(mask, 0, GGML_MAX_N_THREADS * sizeof(bool));
+    long freqs[GGML_MAX_N_THREADS];
+    int n_cpu = 0;
+    long max_freq = -1;
+    for (int i = 0; i < GGML_MAX_N_THREADS; i++) {
+        char path[96];
+        snprintf(path, sizeof(path),
+                 "/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq", i);
+        FILE * f = fopen(path, "r");
+        if (f == NULL) break;
+        long fv = -1;
+        if (fscanf(f, "%ld", &fv) != 1) {
+            fclose(f);
+            break;
+        }
+        fclose(f);
+        freqs[i] = fv;
+        if (fv > max_freq) max_freq = fv;
+        n_cpu++;
+    }
+    if (n_cpu == 0 || max_freq <= 0) return false;
+    for (int i = 0; i < n_cpu; i++) {
+        if (freqs[i] == max_freq) mask[i] = true;
+    }
+    return true;
+}

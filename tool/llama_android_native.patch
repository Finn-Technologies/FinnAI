+// ---------------------------------------------------------------------------
+// FinnAI: persistent disk cache for repacked weights
+//
+// The repack conversion is single-threaded and can take tens of seconds for a
+// multi-GiB model. The repacked layout is a pure function of (CPU caps, model
+// bytes, tensor shapes), so we persist it next to the model file and replay it
+// on subsequent loads. Only one repack buffer exists per process (model loads
+// are sequential); a mutex guards the shared state for safety.
+// ---------------------------------------------------------------------------
+
+#define FINN_REPACK_MAGIC "FNRPK001"
+#define FINN_REPACK_KEY_LEN 64
+
+struct finn_repack_cache_state {
+    std::mutex  mtx;
+    std::string path;
+    std::string key;
+    FILE      * f        = nullptr; // open cache file (read or write mode)
+    bool        reading  = false;   // stream-read mode: cache validated, replay bytes
+    bool        writing  = false;   // stream-write mode: repack + append bytes
+};
+
+static finn_repack_cache_state finn_repack_cache;
+
+void ggml_backend_cpu_repack_set_cache(const char * path, const char * key) {
+    std::lock_guard<std::mutex> lock(finn_repack_cache.mtx);
+    if (finn_repack_cache.f) {
+        fflush(finn_repack_cache.f);
+        fclose(finn_repack_cache.f);
+        finn_repack_cache.f = nullptr;
+    }
+    finn_repack_cache.reading = false;
+    finn_repack_cache.writing = false;
+    if (path && path[0] && key && key[0]) {
+        finn_repack_cache.path = path;
+        // The loader supplies a NUL-terminated hex key; the on-disk header is
+        // a fixed FINN_REPACK_KEY_LEN-byte field. Normalize to exactly that
+        // width (pad with '0') so the written header is deterministic and the
+        // next launch's memcmp always sees identical bytes.
+        char kbuf[FINN_REPACK_KEY_LEN];
+        const size_t len = strnlen(key, FINN_REPACK_KEY_LEN);
+        memcpy(kbuf, key, len);
+        memset(kbuf + len, '0', FINN_REPACK_KEY_LEN - len);
+        finn_repack_cache.key.assign(kbuf, FINN_REPACK_KEY_LEN);
+    } else {
+        finn_repack_cache.path.clear();
+        finn_repack_cache.key.clear();
+    }
+}
+
+void ggml_backend_cpu_repack_clear_cache(void) {
+    ggml_backend_cpu_repack_set_cache(nullptr, nullptr);
+}
+
+// open the cache file for reading; validate magic + key. Returns FILE* or nullptr.
+static FILE * finn_repack_cache_open_read(const std::string & path, const std::string & key) {
+    FILE * f = fopen(path.c_str(), "rb");
+    if (!f) {
+        return nullptr;
+    }
+    char magic[8];
+    char kbuf[FINN_REPACK_KEY_LEN];
+    bool ok = fread(magic, 1, 8, f) == 8 && memcmp(magic, FINN_REPACK_MAGIC, 8) == 0 &&
+              fread(kbuf, 1, FINN_REPACK_KEY_LEN, f) == FINN_REPACK_KEY_LEN &&
+              memcmp(kbuf, key.data(), FINN_REPACK_KEY_LEN) == 0;
+    if (!ok) {
+        fclose(f);
+        return nullptr;
+    }
+    return f;
+}
+
+// (re)create the cache file for writing; write magic + key header. Returns FILE* or nullptr.
+static FILE * finn_repack_cache_open_write(const std::string & path, const std::string & key) {
+    FILE * f = fopen(path.c_str(), "wb");
+    if (!f) {
+        return nullptr;
+    }
+    if (fwrite(FINN_REPACK_MAGIC, 1, 8, f) != 8 ||
+        fwrite(key.data(), 1, FINN_REPACK_KEY_LEN, f) != FINN_REPACK_KEY_LEN) {
+        fclose(f);
+        remove(path.c_str());
+        return nullptr;
+    }
+    return f;
+}

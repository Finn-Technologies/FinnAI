diff --git a/cmake/onnxruntime.cmake b/cmake/onnxruntime.cmake
index e3130fc..52c8c8c 100644
--- a/cmake/onnxruntime.cmake
+++ b/cmake/onnxruntime.cmake
@@ -296,7 +296,17 @@ if(WIN32 AND onnxruntime_BUILD_SHARED_LIB)
   endif()
 endif()
 #See: https://cmake.org/cmake/help/latest/prop_tgt/SOVERSION.html
-if(NOT WIN32)
+# FinnAI: OHOS gets no VERSION/SOVERSION. The HarmonyOS sandbox resolves
+# DT_NEEDED by SONAME out of libs/arm64, and Dart's DynamicLibrary.open() uses
+# the bare filename, so a versioned name would mean shipping the 32 MB library
+# twice under two names. tool/llama_ohos_build.patch does the same for
+# llama.cpp, for the same reason.
+if(CMAKE_SYSTEM_NAME STREQUAL "OHOS")
+  set_target_properties(onnxruntime PROPERTIES
+    PUBLIC_HEADER "${ONNXRUNTIME_PUBLIC_HEADERS}"
+    LINK_DEPENDS ${SYMBOL_FILE}
+    FOLDER "ONNXRuntime")
+elseif(NOT WIN32)
   set_target_properties(onnxruntime PROPERTIES
     PUBLIC_HEADER "${ONNXRUNTIME_PUBLIC_HEADERS}"
     LINK_DEPENDS ${SYMBOL_FILE}
diff --git a/onnxruntime/core/mlas/lib/fp16_common.h b/onnxruntime/core/mlas/lib/fp16_common.h
index 52d57da..6aad0f9 100644
--- a/onnxruntime/core/mlas/lib/fp16_common.h
+++ b/onnxruntime/core/mlas/lib/fp16_common.h
@@ -19,7 +19,17 @@ Abstract:
 #include "mlas_float16.h"
 #include "mlasi.h"
 
-#if defined(MLAS_F16VEC_INTRINSICS_SUPPORTED)
+// FinnAI: MLAS_F16VEC_INTRINSICS_SUPPORTED is defined for every non-Apple
+// ARM64 target, but the NEON FP16 intrinsics below only exist when the
+// translation unit is compiled with -march=armv8.2-a+fp16. ONNX Runtime
+// applies that flag per-source to the *_fp16.cpp kernels and not to the
+// core fp32 translation units, which include this header transitively via
+// mlasi.h. Without the second condition those fp32 TUs fail to compile on
+// any toolchain whose default -march lacks FP16 -- the HarmonyOS clang,
+// for one -- even though they never call anything in this file. Requiring
+// the ISA macro leaves the FP16 kernels fully functional and lets the fp32
+// TUs compile, without adding +fp16 to any fp32 code path.
+#if defined(MLAS_F16VEC_INTRINSICS_SUPPORTED) && defined(__ARM_FEATURE_FP16_VECTOR_ARITHMETIC)
 
 // TODO!! Add intel fp16 implementations
 

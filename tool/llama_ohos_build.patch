diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index d15ccfd..81166d4 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -42,9 +42,12 @@ add_library(llama
             ${LLAMA_MODELS_SOURCES}
             )
 
+# FinnAI OHOS build (tool/llama_ohos_build.patch): VERSION/SOVERSION are
+# dropped so every library keeps a plain, unversioned SONAME.
+# OpenHarmony loads an app's native libs from the bundle's libs/arm64
+# directory and dlopen()s them by bare filename; a versioned SONAME
+# makes the loader look for e.g. libllama.so.0 forever.
 set_target_properties(llama PROPERTIES
-    VERSION ${LLAMA_INSTALL_VERSION}
-    SOVERSION 0
     MACHO_CURRENT_VERSION 0 # keep macOS linker from seeing oversized version number
 )
 

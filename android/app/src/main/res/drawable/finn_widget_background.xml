<?xml version="1.0" encoding="utf-8"?>
<!--
  Rounded surface for a home-screen widget. The per-widget accent colour is
  applied by tinting the accent bar and the title text rather than this
  background, because RemoteViews can only set a flat colour on a view and that
  would lose the corner radius.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#EAEAE7" />
</shape>

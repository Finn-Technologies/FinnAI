<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch splash: FinnAI canvas with the app mark centered.
     Automatically removed when the Flutter engine draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_icon" />
    </item>
</layer-list>

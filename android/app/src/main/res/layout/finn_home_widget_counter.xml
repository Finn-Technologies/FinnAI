<?xml version="1.0" encoding="utf-8"?>
<!--
  Counter widget: a number between minus and plus buttons, with an optional
  goal drawn as ten segments. The segments are plain ImageViews coloured one by
  one because a ProgressBar's colour cannot be set through RemoteViews on the
  Android versions the app supports.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/finn_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/finn_widget_background"
    android:padding="14dp">

    <ImageView
        android:id="@+id/finn_widget_accent"
        android:layout_width="28dp"
        android:layout_height="4dp"
        android:layout_marginBottom="10dp"
        android:background="#7DFFCD" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/finn_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#121212" />

        <TextView
            android:id="@+id/finn_widget_reset"
            style="@style/FinnWidgetReset" />
    </LinearLayout>

    <TextView
        android:id="@+id/finn_widget_label_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="#4A4A48" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/finn_widget_minus"
            android:layout_width="46dp"
            android:layout_height="46dp">

            <ImageView
                android:id="@+id/finn_widget_minus_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/finn_widget_circle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="−"
                android:textColor="#121212"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/finn_widget_value_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#121212"
            android:textSize="34sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/finn_widget_plus"
            android:layout_width="46dp"
            android:layout_height="46dp">

            <ImageView
                android:id="@+id/finn_widget_plus_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/finn_widget_circle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="#121212"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/finn_widget_goal_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/finn_widget_seg_1"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="#E6E6E2" />
        <ImageView
            android:id="@+id/finn_widget_seg_2"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="#E6E6E2" />
        <ImageView
            android:id="@+id/finn_widget_seg_3"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="#E6E6E2" />
        <ImageView
            android:id="@+id/finn_widget_seg_4"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="#E6E6E2" />
        <ImageView
            android:id="@+id/finn_widget_seg_5"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="#E6E6E2" />
        <ImageView
            android:id="@+id/finn_widget_seg_6"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="#E6E6E2" />
        <ImageView
            android:id="@+id/finn_widget_seg_7"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="#E6E6E2" />
        <ImageView
            android:id="@+id/finn_widget_seg_8"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="#E6E6E2" />
        <ImageView
            android:id="@+id/finn_widget_seg_9"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="#E6E6E2" />
        <ImageView
            android:id="@+id/finn_widget_seg_10"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="0dp"
            android:background="#E6E6E2" />
    </LinearLayout>

    <TextView
        android:id="@+id/finn_widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textColor="#4A4A48" />
</LinearLayout>
